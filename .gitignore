reports/checkpoints/*.pt
*.pth
*.pt
*.h5
*.pkl
*.pickle

# ========== PYTHON ==========
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# PyCharm
.idea/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json

